        "/orders/": {
            "get": {
                "operationId": "orders_list",
                "parameters": [
                    {
                        "in": "query",
                        "name": "status",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "cancelled",
                                "on_hold",
                                "open",
                                "shipped"
                            ]
                        }
                    }
                ],
                "tags": [
                    "orders"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Order"
                                    }
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "post": {
                "operationId": "orders_create",
                "tags": [
                    "orders"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OrderIn"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/OrderIn"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/OrderIn"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/orders/{id}/": {
            "get": {
                "operationId": "orders_retrieve",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "integer"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "orders"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Line": {
                "type": "object",
                "properties": {
                    "sku": {
                        "type": "string"
                    },
                    "qty": {
                        "type": "integer"
                    }
                },
                "required": [
                    "qty",
                    "sku"
                ]
            },
            "Order": {
                "type": "object",
                "properties": {
                    "customer_id": {
                        "type": "integer"
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Line"
                        }
                    },
                    "note": {
                        "type": "string",
                        "nullable": true
                    },
                    "id": {
                        "type": "integer"
                    },
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    }
                },
                "required": [
                    "customer_id",
                    "id",
                    "lines",
                    "status"
                ]
            },
            "OrderIn": {
                "type": "object",
                "properties": {
                    "customer_id": {
                        "type": "integer"
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Line"
                        }
                    },
                    "note": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "required": [
                    "customer_id",
                    "lines"
                ]
            },
            "StatusEnum": {
                "enum": [
                    "open",
                    "shipped",
                    "cancelled",
                    "on_hold"
                ],
                "type": "string",
                "description": "* `open` - open\n* `shipped` - shipped\n* `cancelled` - cancelled\n* `on_hold` - on_hold"
            }
        }
    }
}