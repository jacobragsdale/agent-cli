#!/usr/bin/env python3
"""A kubectl that answers from fixtures, for testing the k8s domain without a
cluster. Ported from az-tui's scripts/fake-kubectl.

Put this directory first on PATH. Built in: two contexts, aks-qa with the
namespaces dev, qa and uat, and aks-prod with prod. With AGENT_CLI_FIXTURES
set to a directory holding kubectl.json (a recorded world, see
fixtures/world/README.md), that file's contexts, objects and logs replace
them. Set FAKE_KUBECTL_LOG to a directory and every call is appended to
calls.log there; set FAKE_KUBECTL_DOWN to a context name and that cluster
cannot be reached.
"""
import hashlib
import json
import os
import signal
import sys
import time

args = sys.argv[1:]


def take(flag):
    if flag in args:
        i = args.index(flag)
        value = args[i + 1]
        del args[i : i + 2]
        return value
    return None


# ---------- the objects: built in, or a recorded world ----------


def pod(name, ns, owner, image, status, ready=True, restarts=0, containers=None,
        deleting=False, hash_="7d9f5b", kind="ReplicaSet", node="aks-np1-vmss000000", spec_extra=None):
    cs = containers or [("api", image)]
    statuses = []
    for cname, cimage in cs:
        repo = cimage.split(":")[0]
        st = {"name": cname, "image": cimage, "ready": ready, "restartCount": restarts,
              "imageID": f"{repo}@sha256:{hashlib.sha256(cimage.encode()).hexdigest()}"}
        if status == "CrashLoopBackOff":
            st["state"] = {"waiting": {"reason": "CrashLoopBackOff", "message": "back-off 5m0s"}}
            st["lastState"] = {"terminated": {"reason": "Error", "exitCode": 1}}
            st["ready"] = False
        elif status == "ImagePullBackOff":
            st["state"] = {"waiting": {"reason": "ImagePullBackOff"}}
            st["ready"] = False
            del st["imageID"]
        elif status == "Completed":
            st["state"] = {"terminated": {"reason": "Completed", "exitCode": 0}}
            st["ready"] = False
        elif status == "Pending":
            st["state"] = {"waiting": {"reason": "ContainerCreating"}}
            st["ready"] = False
            del st["imageID"]
        else:
            st["state"] = {"running": {"startedAt": "2026-09-12T09:00:00Z"}}
        statuses.append(st)
    phase = {"Completed": "Succeeded", "Pending": "Pending"}.get(status, "Running")
    owner_name = f"{owner}-{hash_}" if kind == "ReplicaSet" else owner
    spec = {"nodeName": node, "containers": [{"name": c, "image": i} for c, i in cs]}
    spec.update(spec_extra or {})
    item = {
        "kind": "Pod",
        "metadata": {
            "name": name,
            "namespace": ns,
            "creationTimestamp": "2026-09-10T08:00:00Z",
            "labels": {"app": owner, "pod-template-hash": hash_},
            "ownerReferences": [{"kind": kind, "name": owner_name, "controller": True}],
        },
        "spec": spec,
        "status": {"phase": phase, "podIP": "10.244.0.7", "containerStatuses": statuses,
                   "conditions": [{"type": "Ready", "status": "True" if ready and status == "Running" else "False"}]},
    }
    if deleting:
        item["metadata"]["deletionTimestamp"] = "2026-09-12T12:00:00Z"
    return item


def event(name, ns, kind, obj, reason, message, typ="Normal", count=1, last="2026-09-12T12:00:00Z"):
    return {
        "kind": "Event",
        "metadata": {"name": name, "namespace": ns, "creationTimestamp": "2026-09-12T11:00:00Z"},
        "type": typ, "reason": reason, "count": count, "message": message,
        "firstTimestamp": "2026-09-12T11:00:00Z", "lastTimestamp": last,
        "involvedObject": {"kind": kind, "name": obj, "namespace": ns},
        "source": {"component": "kubelet"},
    }


def deployments_of(pods):
    """A Deployment for every ReplicaSet-owned group of pods, as the API has it."""
    found = {}
    for p in pods:
        owner = p["metadata"]["ownerReferences"][0]
        if owner["kind"] != "ReplicaSet":
            continue
        name = owner["name"].rsplit("-", 1)[0]
        key = (p["metadata"]["namespace"], name)
        found.setdefault(key, []).append(p)
    out = []
    for (ns, name), group in found.items():
        out.append({
            "kind": "Deployment",
            "metadata": {"name": name, "namespace": ns, "creationTimestamp": "2026-08-01T00:00:00Z"},
            "spec": {"replicas": len(group),
                     "template": {"spec": {"containers": group[0]["spec"]["containers"]}}},
            "status": {"replicas": len(group),
                       "readyReplicas": sum(1 for p in group if p["status"]["conditions"][0]["status"] == "True"),
                       "conditions": [{"type": "Progressing", "status": "True", "reason": "NewReplicaSetAvailable",
                                       "lastUpdateTime": "2026-09-10T08:00:00Z"}]},
        })
    return out


