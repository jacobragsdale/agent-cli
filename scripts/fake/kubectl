#!/usr/bin/env python3
"""A kubectl that answers from a file, for testing the k8s domain without a
cluster. Ported from az-tui's scripts/fake-kubectl.

Put this directory first on PATH. It reads crates/k8s/fixtures/cluster.json
(two contexts: aks-qa with the namespaces dev, qa and uat, and aks-prod with
prod), or, with AGENT_CLI_FIXTURES set to a directory holding kubectl.json (a
recorded world, see fixtures/world/README.md), that file. Either is
{"contexts": {CONTEXT: [objects]}, "logs": {...}, "forbidden": {CONTEXT:
[kinds]}}; without "logs", a pod's log is made up. `get KIND` answers for the
standard kinds and every kind the file holds (a CustomResourceDefinition
there names its kind's plural and short names), and `api-resources` lists
them. An object without a uid gets one from its context, kind, namespace and
name, and so does an event's involvedObject. Set FAKE_KUBECTL_LOG to a
directory and every call is appended to calls.log there; set
FAKE_KUBECTL_DOWN to a context name and that cluster cannot be reached.
"""
import hashlib
import json
import os
import signal
import sys
import time
import uuid

args = sys.argv[1:]


def take(flag):
    if flag in args:
        i = args.index(flag)
        value = args[i + 1]
        del args[i : i + 2]
        return value
    return None


# ---------- the objects ----------

WORLD = os.environ.get("AGENT_CLI_FIXTURES", "")
WORLD_FILE = os.path.join(WORLD, "kubectl.json") if WORLD else ""
if not (WORLD_FILE and os.path.exists(WORLD_FILE)):
    WORLD_FILE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../../crates/k8s/fixtures/cluster.json")
with open(WORLD_FILE) as f:
    world = json.load(f)
OBJECTS = world["contexts"]
LOGS = world.get("logs")
FORBIDDEN = {(context, kind) for context, kinds in world.get("forbidden", {}).items() for kind in kinds}
NAMESPACES = {name: sorted({o["metadata"]["namespace"] for o in objects if "namespace" in o["metadata"]}
                           | {"default", "kube-system"})
              for name, objects in OBJECTS.items()}


def uid(context, kind, namespace, name):
    return str(uuid.UUID(hashlib.md5(f"{context}/{kind}/{namespace}/{name}".encode()).hexdigest()))


for context, objects in OBJECTS.items():
    objects.extend({"kind": "Namespace", "apiVersion": "v1",
                    "metadata": {"name": n, "creationTimestamp": "2026-01-01T00:00:00Z"},
                    "status": {"phase": "Active"}} for n in NAMESPACES[context])
    for o in objects:
        meta = o["metadata"]
        meta.setdefault("uid", uid(context, o["kind"], meta.get("namespace"), meta["name"]))
        involved = o.get("involvedObject")
        if involved:
            involved.setdefault("uid", uid(context, involved.get("kind"), involved.get("namespace"),
                                           involved.get("name")))

# NAME, SHORTNAMES, APIVERSION, NAMESPACED, KIND: what every cluster serves.
STANDARD = [
    ("pods", "po", "v1", True, "Pod"),
    ("events", "ev", "v1", True, "Event"),
    ("configmaps", "cm", "v1", True, "ConfigMap"),
    ("secrets", "", "v1", True, "Secret"),
    ("services", "svc", "v1", True, "Service"),
    ("serviceaccounts", "sa", "v1", True, "ServiceAccount"),
    ("persistentvolumeclaims", "pvc", "v1", True, "PersistentVolumeClaim"),
    ("persistentvolumes", "pv", "v1", False, "PersistentVolume"),
    ("nodes", "no", "v1", False, "Node"),
    ("namespaces", "ns", "v1", False, "Namespace"),
    ("deployments", "deploy", "apps/v1", True, "Deployment"),
    ("replicasets", "rs", "apps/v1", True, "ReplicaSet"),
    ("statefulsets", "sts", "apps/v1", True, "StatefulSet"),
    ("daemonsets", "ds", "apps/v1", True, "DaemonSet"),
    ("jobs", "", "batch/v1", True, "Job"),
    ("cronjobs", "cj", "batch/v1", True, "CronJob"),
    ("ingresses", "ing", "networking.k8s.io/v1", True, "Ingress"),
    ("networkpolicies", "netpol", "networking.k8s.io/v1", True, "NetworkPolicy"),
    ("storageclasses", "sc", "storage.k8s.io/v1", False, "StorageClass"),
    ("customresourcedefinitions", "crd,crds", "apiextensions.k8s.io/v1", False, "CustomResourceDefinition"),
]


def resources(context):
    """What the API server serves: the standard kinds, every CRD's, and any
    other kind the file holds (a plural guessed from its name)."""
    found = list(STANDARD)
    kinds = {row[4] for row in found}
    objects = OBJECTS.get(context, [])
    for o in objects:
        if o["kind"] == "CustomResourceDefinition" and o["spec"]["names"]["kind"] not in kinds:
            names, spec = o["spec"]["names"], o["spec"]
            found.append((names["plural"], ",".join(names.get("shortNames", [])),
                          f"{spec['group']}/{spec['versions'][0]['name']}", spec["scope"] == "Namespaced",
                          names["kind"]))
            kinds.add(names["kind"])
    for o in objects:
        if o["kind"] not in kinds:
            lower = o["kind"].lower()
            plural = lower + "es" if lower.endswith("s") else lower[:-1] + "ies" if lower.endswith("y") else lower + "s"
            found.append((plural, "", o.get("apiVersion", "v1"), "namespace" in o["metadata"], o["kind"]))
            kinds.add(o["kind"])
    return found


def resource(context, word):
    """The resource a word names, as kubectl reads it: plural, singular,
    short name or kind, with an optional `.group`."""
    base, _, group = word.lower().partition(".")
    for row in resources(context):
        if base in (row[0], row[4].lower(), *row[1].split(",")) and group in ("", row[2].rpartition("/")[0]):
            return row
    return None


def grouped(row):
    """`pods`, `deployments.apps`: how kubectl names a resource in errors."""
    group = row[2].rpartition("/")[0]
    return f"{row[0]}.{group}" if group else row[0]


# ---------- the call ----------

if args[:2] == ["version", "--client"]:
    print(json.dumps({"clientVersion": {"gitVersion": "v1.31.2-fake"}}))
    sys.exit(0)

if args[:2] == ["config", "get-contexts"]:
    print("\n".join(OBJECTS))
    sys.exit(0)

context = take("--context")
args[:] = [a for a in args if not a.startswith("--request-timeout")]
ns = take("-n")
container = take("-c")
selector = take("-l")
fields = take("--field-selector")
all_ns = "--all-namespaces" in args or "-A" in args
args[:] = [a for a in args if a not in ("--all-namespaces", "-A")]

log_dir = os.environ.get("FAKE_KUBECTL_LOG")
if log_dir:
    with open(os.path.join(log_dir, "calls.log"), "a") as f:
        f.write(" ".join(sys.argv[1:]) + "\n")

if context not in OBJECTS:
    sys.stderr.write(f'error: context "{context}" does not exist\n')
    sys.exit(1)
if os.environ.get("FAKE_KUBECTL_DOWN") == context:
    sys.stderr.write(
        "E0912 12:00:00.000000   12345 memcache.go:265] couldn't get current server API group list\n"
        "Unable to connect to the server: dial tcp 10.0.0.1:443: i/o timeout\n"
    )
    sys.exit(1)


def labelled(o):
    """What `-l a=b,c` selects: every pair equal, every bare key present."""
    labels = o["metadata"].get("labels", {})
    for term in (selector or "").split(","):
        key, _, value = term.partition("=")
        if term and (key not in labels or (value and labels[key] != value)):
            return False
    return True


def fielded(o):
    """What `--field-selector a.b=c` selects: every dotted path equal."""
    for term in (fields or "").split(","):
        path, _, value = term.partition("=")
        held = o
        for part in path.split(".") if term else []:
            held = held.get(part, {}) if isinstance(held, dict) else {}
        if term and held != value:
            return False
    return True


def here(kind):
    namespaced = next((row[3] for row in resources(context) if row[4] == kind), True)
    return [o for o in OBJECTS.get(context, [])
            if o["kind"] == kind and (all_ns or not namespaced or o["metadata"].get("namespace") == ns)
            and labelled(o) and fielded(o)]


def forbidden(kind):
    plural = kind.lower() + "s"
    sys.stderr.write(f'Error from server (Forbidden): {plural} is forbidden: User "dev-user" cannot list resource '
                     f'"{plural}" in API group "" in the namespace "{ns}"\n')
    sys.exit(1)


def unknown(word):
    sys.stderr.write(f'error: the server doesn\'t have a resource type "{word}"\n')
    sys.exit(1)


def find(row, name):
    for o in here(row[4]):
        if o["metadata"]["name"] == name:
            return o
    sys.stderr.write(f'Error from server (NotFound): {grouped(row)} "{name}" not found\n')
    sys.exit(1)


if args[:1] == ["api-resources"]:
    table = [("NAME", "SHORTNAMES", "APIVERSION", "NAMESPACED", "KIND", "VERBS", "CATEGORIES")] + [
        (name, short, api, str(namespaced).lower(), kind,
         "[create delete deletecollection get list patch update watch]", "")
        for name, short, api, namespaced, kind in resources(context)]
    widths = [max(len(row[i]) for row in table) + 3 for i in range(6)]
    for row in table:
        print("".join(cell.ljust(width) for cell, width in zip(row, widths)) + row[6])
    sys.exit(0)

if args[:2] == ["get", "namespaces"] and "name" in args:
    print("\n".join(f"namespace/{n}" for n in NAMESPACES[context]))
    sys.exit(0)

if args[:1] == ["get"] and len(args) >= 2 and "/" not in args[1] and (len(args) == 2 or args[2].startswith("-")):
    # As kubectl itself does: `get` has no --limit, and a fake that took it
    # hid a doctor that failed every scope on a real cluster.
    if any(a.startswith("--limit") for a in args):
        sys.stderr.write("error: unknown flag: --limit\nSee 'kubectl get --help' for usage.\n")
        sys.exit(1)
    rows = []
    for word in args[1].split(","):
        rows.append(resource(context, word) or unknown(word))
    if ns == "forbidden":
        forbidden(rows[0][4])
    for row in rows:
        if (context, row[4]) in FORBIDDEN:
            forbidden(row[4])
    items = [o for row in rows for o in here(row[4])]
    if "name" in args and "-o" in args:
        print("\n".join(f"{o['kind'].lower()}/{o['metadata']['name']}" for o in items[:1]))
        sys.exit(0)
    print(json.dumps({"apiVersion": "v1", "kind": "List", "items": items}))
    sys.exit(0)

if args[:1] == ["get"] and len(args) >= 3 and "/" not in args[1] and "json" in args:
    row = resource(context, args[1]) or unknown(args[1])
    print(json.dumps(find(row, args[2])))
    sys.exit(0)

if args[:1] == ["logs"]:
    name = args[1]
    find(resource(context, "pod"), name)
    previous = "-p" in args
    tag = f"{container or 'api'}{' previous' if previous else ''}"
    if LOGS is not None:
        key = f"{context}/{ns}/{name}/{container or 'api'}{'/previous' if previous else ''}"
        if key not in LOGS and not container:
            key = next((k for k in LOGS if k.startswith(f"{context}/{ns}/{name}/")
                        and k.endswith("/previous") == previous), key)
        lines = LOGS.get(key, "").splitlines()
        tail = next((int(a.split("=", 1)[1]) for a in args if a.startswith("--tail=")), len(lines))
        for line in lines[-tail:] if tail else []:
            print(line)
        sys.exit(0)
    if "-f" not in args:
        # The bounded form the k8s domain asks for: the last --tail lines, then exit.
        tail = next((int(a.split("=", 1)[1]) for a in args if a.startswith("--tail=")), 30)
        for i in range(max(1, 31 - tail), 31):
            level = "ERROR" if i % 7 == 0 else "INFO"
            print(f"2026-09-12T12:00:{i:02d}Z {level} {name} {tag} line {i}")
        sys.exit(0)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        for i in range(1, 10_000):
            level = "ERROR" if i % 7 == 0 else ("WARN" if i % 5 == 0 else "INFO")
            print(f"2026-09-12T12:{i // 60:02d}:{i % 60:02d}Z {level} {name} {tag} line {i}", flush=True)
            time.sleep(0.3)
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    sys.exit(0)

if args[:2] == ["describe", "pod"]:
    name = args[2]
    print(
        f"Name:         {name}\nNamespace:    {ns}\nNode:         aks-np1-vmss000000\n"
        "Status:       Running\nIP:           10.244.0.7\nContainers:\n  api:\n"
        "    Image:  contosoacr.azurecr.io/team/x:1\nEvents:\n"
        "  Normal  Pulled  2m  kubelet  Successfully pulled image"
    )
    sys.exit(0)

if args[:1] == ["describe"] and len(args) >= 3:
    # Any other kind: what `d` asks for on a configmap, a secret, or the
    # object an event names.
    kind, name = args[1], args[2]
    print(
        f"Name:         {name}\nNamespace:    {ns}\nKind:         {kind.capitalize()}\n"
        "Labels:       app=orders\nAnnotations:  <none>\n\nEvents:  <none>"
    )
    sys.exit(0)

if args[:2] == ["delete", "pod"]:
    print(f'pod "{args[2]}" deleted')
    sys.exit(0)

if args[:2] == ["rollout", "restart"]:
    print(f"{args[2]} restarted")
    sys.exit(0)

if args[:2] == ["rollout", "status"]:
    # kubectl's deployment status viewer: given up, still going, or done.
    name = args[2].split("/", 1)[-1]
    found = [o for o in here("Deployment") if o["metadata"]["name"] == name]
    if not found:
        sys.stderr.write(f'Error from server (NotFound): deployments.apps "{name}" not found\n')
        sys.exit(1)
    status = found[0]["status"]
    progressing = next((c for c in status.get("conditions", []) if c["type"] == "Progressing"), {})
    if progressing.get("reason") == "ProgressDeadlineExceeded":
        sys.stderr.write(f'error: deployment "{name}" exceeded its progress deadline\n')
        sys.exit(1)
    updated = status.get("updatedReplicas", status.get("replicas", 0))
    available = status.get("availableReplicas", status.get("readyReplicas", 0))
    if updated >= found[0]["spec"].get("replicas", 1) and available >= updated:
        print(f'deployment "{name}" successfully rolled out')
        sys.exit(0)
    print(f'Waiting for deployment "{name}" rollout to finish: {available} of {updated} updated replicas are available...',
          flush=True)
    timeout = next((a.split("=", 1)[1] for a in args if a.startswith("--timeout=")), "0s")
    time.sleep(int(timeout.rstrip("s")))
    sys.stderr.write("error: timed out waiting for the condition\n")
    sys.exit(1)

if args[:1] == ["scale"]:
    print(f"{args[1]} scaled")
    sys.exit(0)

if args[:1] == ["get"] and "/" in args[1] and "-o" in args and "json" in args:
    kind, name = args[1].split("/", 1)
    row = resource(context, kind)
    found = [o for o in here(row[4] if row else kind.capitalize()) if o["metadata"]["name"] == name]
    # A ReplicaSet named DEPLOYMENT-HASH is that Deployment's, as the API has it.
    base = name.rsplit("-", 1)[0]
    owners = [{"kind": "Deployment", "name": base, "controller": True}] \
        if kind == "replicaset" and any(d["metadata"]["name"] == base for d in here("Deployment")) else []
    print(json.dumps(found[0] if found else {
        "apiVersion": "apps/v1", "kind": kind.capitalize(),
        "metadata": {"name": name, "namespace": ns, "ownerReferences": owners},
        # A deployment named paused-* is paused (kubectl rollout pause).
        "spec": {"replicas": 3, **({"paused": True} if name.startswith("paused-") else {})},
        "status": {"readyReplicas": 3, "replicas": 3},
    }))
    sys.exit(0)

if args[:1] == ["get"] and "/" in args[1] and "yaml" in args:
    kind, name = args[1].split("/", 1)
    print(f"apiVersion: apps/v1\nkind: {kind.capitalize()}\nmetadata:\n  name: {name}\n  namespace: {ns}\n")
    sys.exit(0)

if args[:1] == ["get"] and len(args) >= 3 and "yaml" in args:
    print(f"apiVersion: v1\nkind: {args[1].capitalize()}\nmetadata:\n  name: {args[2]}\n  namespace: {ns}\nspec:\n  nodeName: aks-np1-vmss000000\n")
    sys.exit(0)

if args[:1] == ["exec"]:
    # What a shell in the pod would do: print and leave, so the TUI repaints.
    # The pod is the last argument before `--`; -n and -c were taken above.
    pod_name = args[args.index("--") - 1] if "--" in args else args[-1]
    print(f"fake shell in {pod_name}")
    sys.exit(0)

sys.stderr.write("error: fake kubectl does not know: " + " ".join(sys.argv[1:]) + "\n")
sys.exit(2)
