#!/bin/sh
# An az for tests and fixture trials, without Azure: it knows
# `aks get-credentials` (for `aks cluster connect`) and hands out a stand-in
# access token for any resource (for AGENT_CLI_FIXTURES worlds, whose replayed
# answers ignore it). Put this directory first on PATH.
if [ "$1 $2" = "aks get-credentials" ]; then
  echo "Merged \"$6\" as current context in /nonexistent/.kube/config"
  exit 0
fi
if [ "$1 $2" = "account get-access-token" ]; then
  echo "fake-az-token"
  exit 0
fi
echo "ERROR: the fake az does not know: $*" >&2
exit 2
