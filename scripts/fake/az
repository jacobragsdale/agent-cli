#!/bin/sh
# An az for tests and fixture trials, without Azure: it knows
# `aks get-credentials` (for `aks cluster connect`), `account show` (the
# login `--caller @me` names) and hands out a stand-in access token for any
# resource (for AGENT_CLI_FIXTURES worlds, whose replayed answers ignore it).
# Put this directory first on PATH.
if [ "$1 $2" = "aks get-credentials" ]; then
  echo "Merged \"$6\" as current context in /nonexistent/.kube/config"
  exit 0
fi
if [ "$1 $2" = "account show" ]; then
  echo "ops@contoso.example"
  exit 0
fi
if [ "$1 $2" = "account get-access-token" ]; then
  # A JWT whose claims name the signed-in user, its tenant and its Graph scopes
  # (lake access get --principal @me, doctor entra).
  echo "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJvaWQiOiIwMDAwMDAwMC0wMDAwLTQwMDAtODAwMC0wMDAwMDAwMDAwZTEiLCJ1cG4iOiJvcHNAY29udG9zby5leGFtcGxlIiwidGlkIjoiMDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDBhMDAxIiwic2NwIjoiQXVkaXRMb2cuUmVhZC5BbGwgRGlyZWN0b3J5LkFjY2Vzc0FzVXNlci5BbGwgR3JvdXAuUmVhZFdyaXRlLkFsbCBVc2VyLlJlYWRXcml0ZS5BbGwifQ.fake"
  exit 0
fi
echo "ERROR: the fake az does not know: $*" >&2
exit 2
